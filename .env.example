# Copy to .env and fill in values (never commit .env)
# App loads .env with override=True so these values beat the same keys in your shell/IDE.

# Azure Speech (STT only; TTS uses Azure OpenAI below)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Azure OpenAI — TTS (gpt-4o-mini-tts deployment)
AZURE_OPENAI_TTS_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com
AZURE_OPENAI_TTS_API_KEY=
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts
AZURE_OPENAI_TTS_API_VERSION=2025-04-01-preview
AZURE_OPENAI_TTS_VOICE=nova
# Optional. Empty = omit (model default). Set to lock one narrator (stops “different voices” on quotes).
# AZURE_OPENAI_TTS_INSTRUCTIONS=

# Azure OpenAI — chat / tools
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure Embeddings (menu semantic search)
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_API_KEY=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Azure PostgreSQL
PGSQL_ENDPOINT=
PGSQL_DB_NAME=postgres
PGSQL_ADMIN_USERNAME=
PGSQL_ADMIN_PASSWORD=

# MongoDB — draft orders (place_order tool)
MONGODB_URI=
# Or: MONGO_URL= (alias) and DATABASE_NAME= (alias for DB name)
MONGODB_DB_NAME=kellner
MONGODB_ORDERS_COLLECTION=orders

# Voice session defaults until auth (must match seeded hotel / customer in Postgres)
DEFAULT_HOTEL_ID=1
DEFAULT_CUSTOMER_ID=1

# Browser origins allowed to call the API (comma-separated). Defaults: localhost Vite dev ports.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
# When the SPA is opened as http://YOUR_VM_PUBLIC_IP (nginx static + /api proxy), add that origin (no :80):
# CORS_EXTRA_ORIGINS=http://74.249.2.119

# Local face (InsightFace on VM + pgvector) — optional
# INSIGHTFACE_ROOT=/opt/kellner/.insightface
# FACE_MATCH_MAX_DISTANCE=0.45
